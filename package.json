{
  "name": "temp-payload",
  "version": "1.0.0",
  "description": "Web Li family portal built with Next.js 15 and Payload CMS v3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts",
    "seed:phase-9": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --phase-9",
    "seed:phase-9:refresh-media": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --phase-9 --refresh-media-source",
    "seed:phase-9:refresh-missing-media": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --phase-9 --refresh-missing-current-media",
    "seed:dry-run": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --dry-run",
    "seed:phase-9:dry-run": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --phase-9 --dry-run",
    "seed:phase-9:read-back": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --phase-9-read-back",
    "seed:audit": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed-audit.ts",
    "seed:blog": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed.ts --blog-only",
    "test:seed-content": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed-content.test.ts",
    "test:phase-9": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/scripts/seed-content.test.ts && node --import tsx src/scripts/seed-audit.test.ts && node --import tsx src/scripts/seed-dry-run.test.ts && node --import tsx src/scripts/seed-upload-name.test.ts && node --import tsx src/scripts/seed-media-repair.test.ts && node --import tsx src/scripts/seed-member-locale.test.ts && node --import tsx src/scripts/seed-media-context.test.ts && node --import tsx src/features/travel/travel-detail-page.test.tsx && node --import tsx src/features/travel/youtube.test.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/payload-cloud": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/storage-s3": "3.85.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "15.4.11",
    "payload": "3.85.1",
    "radix-ui": "^1.5.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "shadcn": "^4.11.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
